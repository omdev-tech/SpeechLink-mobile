{
  "expo": {
    "name": "Speech Link",
    "slug": "speech-link-mobile",
    "version": "2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A6FEA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "viewport": {
        "width": "device-width",
        "initialScale": 1,
        "maximumScale": 1,
        "userScalable": false,
        "viewportFit": "cover"
      }
    },
    "extra": {
      "eas": {
        "projectId": "6fc68554-48d3-4b26-a2a9-c4fae0ab35d0"
      }
    },
    "newArchEnabled": true,
    "scheme": "com.naqued.speechlinkmobile",
    "owner": "naqued",
    "android": {
      "package": "com.naqued.speechlinkmobile",
      "versionCode": 40,
      "permissions": [
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS",
        "RECORD_AUDIO"
      ],
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#4A6FEA"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.naqued.speechlinkmobile",
      "supportsTablet": true
    },
    "plugins": [
      "./app.plugin.js",
      [
        "expo-build-properties",
        {
          "android": {
            "useNewNdkIntegration": true,
            "useLegacyPackaging": false,
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-font"
    ]
  }
}
